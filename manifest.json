{
  "manifest_version": 3,
  "name": "WordNest: Personal Dictionary",
  "version": "1.0.0",
  "description": "Select a word on any page, right-click to save it, and build your own personal dictionary with definitions, notes, and export.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.dictionaryapi.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WordNest — view your saved words",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
